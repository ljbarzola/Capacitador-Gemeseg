# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
DATABASE_URL="postgresql://gemeseg:gemeseg@localhost:5433/capacitador?schema=public"

# Firebase (config publica del cliente: consola Firebase > Configuracion del proyecto > Tus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Solo desarrollo local: proyecto de cuota para las credenciales de gcloud (firebase-admin)
GOOGLE_CLOUD_QUOTA_PROJECT=capacitaciongemeseg
